{
  "name": "mygarage-frontend",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "validate:translations": "bun run scripts/validate-translations.ts && bun run scripts/validate-i18n-usage.ts && bun run scripts/validate-hardcoded-strings.ts && bun run scripts/validate-reachability.ts && bun run scripts/validate-units.ts && bun run scripts/validate-units-manifest.ts && bun run validate:units-corpus",
    "validate:reachability": "bun run scripts/validate-reachability.ts",
    "validate:i18n-usage": "bun run scripts/validate-i18n-usage.ts",
    "validate:hardcoded-strings": "bun run scripts/validate-hardcoded-strings.ts",
    "validate:units": "bun run scripts/validate-units.ts",
    "enumerate:binary-distance": "bun run scripts/enumerate-binary-distance.ts",
    "enumerate:fuel-consumption": "bun run scripts/enumerate-fuel-consumption.ts",
    "enumerate:unit-disagreements": "bun run scripts/enumerate-unit-disagreements.ts",
    "enumerate:unit-copy": "bun run scripts/enumerate-unit-copy.ts",
    "enumerate:unit-entry-grid": "bun run scripts/enumerate-unit-entry-grid.ts",
    "enumerate:doc-unit-claims": "bun run scripts/enumerate-doc-unit-claims.ts",
    "validate:units-corpus": "python3 scripts/units_gate_corpus.py",
    "validate:units-selftest": "python3 scripts/units_gate_selftest.py",
    "validate:units-manifest": "bun run scripts/validate-units-manifest.ts",
    "validate:units-manifest-selftest": "python3 scripts/units_manifest_selftest.py",
    "generate:translation-status": "bun run scripts/generate-translation-status.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "generate:schema": "cd ../backend && PYTHONPATH=. uv run python scripts/export_openapi.py ../frontend/src/types/openapi.json",
    "generate:types": "bunx openapi-typescript src/types/openapi.json -o src/types/api.generated.ts",
    "generate:api": "bun run generate:schema && bun run generate:types",
    "check:api-freshness": "bun run generate:api && git diff --exit-code src/types/openapi.json src/types/api.generated.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@schedule-x/calendar": "^4.8.0",
    "@schedule-x/calendar-controls": "^4.8.0",
    "@schedule-x/events-service": "^4.8.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.8.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
